{
  "name": "wallflower-board",
  "version": "0.1.1",
  "description": "A shared whiteboard your agent fills before a meeting and reads back afterwards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jshph/wallflower.git"
  },
  "homepage": "https://github.com/jshph/wallflower#readme",
  "bugs": {
    "url": "https://github.com/jshph/wallflower/issues"
  },
  "type": "module",
  "keywords": [
    "whiteboard",
    "tldraw",
    "agents",
    "meetings",
    "facilitation"
  ],
  "bin": {
    "wallflower": "bin/wallflower.mjs",
    "wf": "bin/wallflower.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist",
    "examples",
    "skill"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node bin/wallflower.mjs serve",
    "build": "vite build",
    "prepack": "vite build",
    "test": "node --test test/*.test.mjs",
    "demo": "node examples/demo/run.mjs"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "3.15.6",
    "vite": "^8.3.6"
  }
}
